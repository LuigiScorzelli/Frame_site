# Copy to .env.local and fill in. Never commit real values.

# --- Email notifications (Resend) ---
# API key from resend.com. Without it the contact form answers 200 but sends nothing (warning in logs).
RESEND_API_KEY=
# Inbox that receives the contact form and the applications to the 5-client offer (POST /api/candidatura).
# Without RESEND_API_KEY, or without Upstash (below: each application is saved there for 6 months before the
# email), the application form answers 503 "Candidature non ancora attive", never a fake success.
CONTACT_TO_EMAIL=info@aiframe.it
# Sender on a domain verified in Resend (SPF, DKIM, DMARC).
RESEND_FROM="aiframe <noreply@aiframe.it>"

# --- Newsletter and check-up email (Brevo, double opt-in) ---
# All four are required: if any is missing, POST /api/newsletter answers 503 "Iscrizioni non ancora attive".
# Create the text attributes FONTE and INTERESSE in Brevo before enabling.
# FONTE values: newsletter, checkup, beta, offerta (applicants who also ticked the optional updates box).
BREVO_API_KEY=
# Numeric id of the list the confirmed contacts join.
BREVO_LIST_ID=
# Numeric id of the double opt-in template (must contain the {{ doubleoptin }} link).
BREVO_DOI_TEMPLATE_ID=
# Page shown after the visitor confirms, e.g. https://aiframe.it/grazie
BREVO_REDIRECT_URL=

# --- Rate limit and application copies (Upstash Redis, Vercel Marketplace free plan) ---
# Required by POST /api/candidatura (keys candidatura:<date>:<id>, 6-month expiry).
# Without these, each server instance keeps its own in-memory limit (warning in logs).
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN: those are read too.
# Use the read-write token (KV_REST_API_TOKEN), not KV_REST_API_READ_ONLY_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salt for the SHA-256 hash of visitor IPs (rate-limit keys and logs). Any long random string.
RATELIMIT_SALT=

# --- Anti-bot on the forms (Cloudflare Turnstile) ---
# Both from the Cloudflare dashboard > Turnstile > widget (mode "Managed"; add aiframe.it and www.aiframe.it as
# hostnames). Set both or neither: with both empty the forms work with honeypot and rate limits only; with only
# the secret set every form answers 403, because the browser sends no token.
# Site key: public, inlined at build time. It also adds the Turnstile line to /privacy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key: server only, checks each token in the four form routes. Never NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
# Local tests without an account: Cloudflare's public test pair (site key 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA) always passes; they work on localhost only as a pair.

# --- Check-up (POST /api/checkup) ---
# Honest User-Agent sent to the analysed sites. Optional: this is the default.
CHECKUP_USER_AGENT="aiframe-checkup/1.0 (+https://www.aiframe.it/check-up)"
# Brevo: create the text attribute SITO (like FONTE) before relying on it; until then the contact is
# created without SITO (warning in logs).

# --- Brand and public links (inlined at build time) ---
# WordPress.org plugin page once approved. Empty: install buttons serve the beta zip.
NEXT_PUBLIC_WPORG_URL=
# Freemius customer portal (sprint 2). Empty: "Il mio account" is hidden. Leave empty on Production until launch.
NEXT_PUBLIC_ACCOUNT_URL=

# --- Privacy and cookie banner (iubenda) ---
# Widget id from the panel's embed code: embeds.iubenda.com/widgets/<id>.js (public). Empty: no banner, and
# statistics and Calendly load as before. Set: statistics load only after "Misurazione" consent, the Calendly
# embed only after "Esperienza" consent (src/lib/iubenda.ts).
NEXT_PUBLIC_IUBENDA_WIDGET_ID=
# Policy id (cookiePolicyId, public). Set it only when the privacy and cookie policy is published on iubenda
# (paid licence): until then iubenda answers 404 and the links stay hidden.
NEXT_PUBLIC_IUBENDA_POLICY_ID=

# --- Freemius checkout, SANDBOX ONLY (sprint 2) ---
# Set these on Vercel for Preview and Development only, never Production. The checkout is also off on
# VERCEL_ENV=production by code. Product ID, plan ID and public key: Freemius panel > Settings / Plans.
NEXT_PUBLIC_FREEMIUS_PRODUCT_ID=
NEXT_PUBLIC_FREEMIUS_PLAN_ID=
NEXT_PUBLIC_FREEMIUS_PUBLIC_KEY=
# Secret key (sk_...): server only, signs the sandbox parameters in /api/freemius/sandbox. Never NEXT_PUBLIC_.
FREEMIUS_SECRET_KEY=

# --- Statistics (Umami Cloud, EU region) ---
# Website ID from the Umami panel. The script loads only on Vercel production (VERCEL_ENV=production).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
