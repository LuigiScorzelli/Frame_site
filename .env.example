# Copy to .env.local and fill in. Never commit real values.

# --- Email notifications (Resend) ---
# API key from resend.com. Without it the contact form answers 200 but sends nothing (warning in logs).
RESEND_API_KEY=
# Inbox that receives the contact form.
CONTACT_TO_EMAIL=info@aiframe.it
# Sender on a domain verified in Resend (SPF, DKIM, DMARC).
RESEND_FROM="aiframe <noreply@aiframe.it>"

# --- Newsletter and check-up email (Brevo, double opt-in) ---
# All four are required: if any is missing, POST /api/newsletter answers 503 "Iscrizioni non ancora attive".
# Create the text attributes FONTE and INTERESSE in Brevo before enabling.
BREVO_API_KEY=
# Numeric id of the list the confirmed contacts join.
BREVO_LIST_ID=
# Numeric id of the double opt-in template (must contain the {{ doubleoptin }} link).
BREVO_DOI_TEMPLATE_ID=
# Page shown after the visitor confirms, e.g. https://aiframe.it/grazie
BREVO_REDIRECT_URL=

# --- Rate limit (Upstash Redis, Vercel Marketplace free plan) ---
# Without these, each server instance keeps its own in-memory limit (warning in logs).
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN: those are read too.
# Use the read-write token (KV_REST_API_TOKEN), not KV_REST_API_READ_ONLY_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salt for the SHA-256 hash of visitor IPs (rate-limit keys and logs). Any long random string.
RATELIMIT_SALT=

# --- Check-up (POST /api/checkup) ---
# Honest User-Agent sent to the analysed sites. Optional: this is the default.
CHECKUP_USER_AGENT="aiframe-checkup/1.0 (+https://www.aiframe.it/check-up)"
# Brevo: create the text attribute SITO (like FONTE) before relying on it; until then the contact is
# created without SITO (warning in logs).

# --- Brand and public links (inlined at build time) ---
# Provisional plugin name until the final one is chosen.
NEXT_PUBLIC_PLUGIN_NAME="Lead Assistant"
# WordPress.org plugin page once approved. Empty: install buttons serve the beta zip.
NEXT_PUBLIC_WPORG_URL=
# Freemius customer portal (sprint 2). Empty: "Il mio account" is hidden.
NEXT_PUBLIC_ACCOUNT_URL=

# --- Statistics (Umami Cloud, EU region) ---
# Website ID from the Umami panel. The script loads only on Vercel production (VERCEL_ENV=production).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
